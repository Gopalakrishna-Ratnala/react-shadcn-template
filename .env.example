# Copy this file to .env.local and adjust values as needed.
# .env.local is gitignored (see .gitignore's *.local pattern) — never commit real values there.

# Base URL for the local mock API server (json-server).
# Must match the --port used in the "mock-api" npm script.
VITE_API_BASE_URL=http://localhost:3001

# Optional - defaults to "development" if unset.
VITE_APP_ENV=development
